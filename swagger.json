{
  "openapi": "3.0.0",
  "info": {
    "title": "Kizuna Rail API",
    "version": "1.0.0",
    "description": "JSON API for the Kizuna Rail scenic train trips application"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Failed to fetch trains"
          }
        }
      }
    }
  },
  "paths": {
    "/api/trains": {
      "get": {
        "summary": "Get all trains",
        "tags": [
          "Trains"
        ],
        "responses": {
          "200": {
            "description": "A JSON array of trains",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "example": "series-e353"
                      },
                      "name": {
                        "type": "string",
                        "example": "Series E353 Limited Express"
                      },
                      "operator": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "maxSpeedKmh": {
                        "type": "number"
                      },
                      "capacity": {
                        "type": "number"
                      },
                      "powerSource": {
                        "type": "string"
                      },
                      "bestFor": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "imageUrl": {
                        "type": "string"
                      },
                      "imageAlt": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": []
}