{
  "openapi": "3.0.0",
  "info": {
    "title": "Kizuna Rail API",
    "version": "1.0.0",
    "description": "JSON API for the Kizuna Rail scenic train trips application"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Failed to fetch trains"
          }
        }
      },
      "Trip": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "alpine-panorama"
          },
          "name": {
            "type": "string",
            "example": "Alpine Panorama Express"
          },
          "description": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "example": "central"
          },
          "startStation": {
            "type": "string",
            "example": "nagoya"
          },
          "endStation": {
            "type": "string",
            "example": "toyama"
          },
          "duration": {
            "type": "string",
            "example": "4.5 hours"
          },
          "distance": {
            "type": "number",
            "description": "Distance in kilometers",
            "example": 180
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bestSeason": {
            "type": "string",
            "example": "autumn"
          },
          "operatingMonths": {
            "type": "array",
            "description": "Month numbers, 1 (January) to 12 (December)",
            "items": {
              "type": "integer"
            }
          },
          "imageUrl": {
            "type": "string",
            "example": "/images/routes/alpine-panorama.png"
          }
        }
      }
    }
  },
  "paths": {
    "/api/trains": {
      "get": {
        "summary": "Get all trains",
        "tags": [
          "Trains"
        ],
        "responses": {
          "200": {
            "description": "A JSON array of trains",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "example": "series-e353"
                      },
                      "name": {
                        "type": "string",
                        "example": "Series E353 Limited Express"
                      },
                      "operator": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "maxSpeedKmh": {
                        "type": "number"
                      },
                      "capacity": {
                        "type": "number"
                      },
                      "powerSource": {
                        "type": "string"
                      },
                      "bestFor": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "imageUrl": {
                        "type": "string"
                      },
                      "imageAlt": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips": {
      "get": {
        "summary": "Get all trips",
        "tags": [
          "Trips"
        ],
        "responses": {
          "200": {
            "description": "A JSON array of trips",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Trip"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/trips/{id}": {
      "get": {
        "summary": "Get one trip by ID",
        "tags": [
          "Trips"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The trip's string ID",
            "schema": {
              "type": "string",
              "example": "alpine-panorama"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested trip",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            }
          },
          "404": {
            "description": "No trip with that ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings": {
      "get": {
        "summary": "Get all bookings",
        "tags": [
          "Bookings"
        ],
        "responses": {
          "200": {
            "description": "A JSON array of bookings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "example": "JRABC12345"
                      },
                      "scheduleId": {
                        "type": "number"
                      },
                      "tripId": {
                        "type": "string"
                      },
                      "ticketClass": {
                        "type": "string"
                      },
                      "selectedDay": {
                        "type": "string"
                      },
                      "passengers": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "firstName": {
                              "type": "string"
                            },
                            "lastName": {
                              "type": "string"
                            },
                            "email": {
                              "type": "string"
                            },
                            "phone": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "createdAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "User does not have permission to access bookings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": []
}