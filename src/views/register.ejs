<%- include('./partials/header') %>

<section class="auth-form">
    <h1>Create an account</h1>

    <% if (errors.length > 0) { %>
        <div class="auth-errors" role="alert">
            <ul>
                <% errors.forEach((message) => { %>
                    <li><%= message %></li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <form method="post" action="/register">
        <label for="displayName">Display name</label>
        <input id="displayName" name="displayName" type="text" maxlength="100" autocomplete="name" required value="<%= values.displayName || '' %>">

        <label for="username">Username</label>
        <input id="username" name="username" type="text" minlength="3" maxlength="30" autocomplete="username" required value="<%= values.username || '' %>">

        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required value="<%= values.email || '' %>">

        <label for="password">Password</label>
        <input id="password" name="password" type="password" minlength="8" autocomplete="new-password" required>

        <label for="confirmPassword">Confirm password</label>
        <input id="confirmPassword" name="confirmPassword" type="password" minlength="8" autocomplete="new-password" required>

        <button type="submit">Register</button>
    </form>

    <p>Already have an account? <a href="/login">Log in</a></p>
</section>

<%- include('./partials/footer') %>
